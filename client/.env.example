# ─── LocalTube Server Configuration ──────────────────────────────────────

# Absolute path to your Videos folder
VIDEOS_DIR=/home/YOUR_USER/Videos

# Server port (default: 3001)
PORT=3001

# Frontend origin for CORS (default: Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Set to 'false' to disable auto-scan on server startup
AUTO_SCAN=true